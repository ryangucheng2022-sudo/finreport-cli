#!/usr/bin/env python3
"""finreport - A-share listed company financial report fetcher (full edition).

Give a company name (or 6-digit code): resolves the stock, fetches formal
financial report data from Eastmoney's structured F10 APIs, and produces a
full workbook: key indicators + complete income statement, balance sheet
and cash flow statement (current period vs same period last year), plus a
single-quarter split derived from cumulative figures.

Data-scope rules:
- Formal quarterly / semi-annual / annual reports only. Earnings forecasts,
  flash reports, guidance and estimates are never used.
- Turnover days come from Eastmoney's main-indicator API (CHZZTS etc.);
  they are never recomputed locally - reconciliations showed the vendor's
  definition differs by company, so local recomputation would corrupt them.
- Amounts in workbooks are in thousand CNY (K元), matching peer-report
  conventions; JSON output keeps raw yuan values.

Network: this host reaches the internet through an authenticating egress
proxy. urllib intermittently gets RemoteDisconnected through it, so the
transport uses a manual HTTP CONNECT tunnel with Proxy-Authorization and
retries. Plain direct connections are used when no proxy env var is set.

Python 3.9+, only third-party dependency: openpyxl (workbook output).
Exit codes: 0 ok, 2 data/source errors, 64 usage errors.
"""
import json
import os
import ssl
import sys
import time
import base64
import http.client
import urllib.parse
import urllib.request
import urllib.error
from datetime import datetime

VERSION = "1.0.0"

API_BASE = "https://emweb.securities.eastmoney.com/PC_HSF10/NewFinanceAnalysis"
CLIST_URL = ("https://push2delay.eastmoney.com/api/qt/clist/get"
             "?pn={pn}&pz=500&po=1&np=1&fltt=2&invt=2&fid=f12"
             "&fs=m:0+t:6,m:0+t:80,m:1+t:2,m:1+t:23,m:0+t:81+s:2048"
             "&fields=f12,f14")
UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"
REFERER = "https://emweb.securities.eastmoney.com/"

PACKAGE_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CACHE_DIR = os.path.join(os.path.expanduser("~"), ".finreport")
STOCK_CACHE = os.path.join(CACHE_DIR, "stock_list.json")
STOCK_CACHE_TTL = 24 * 3600

EXIT_OK, EXIT_DATA, EXIT_USAGE = 0, 2, 64


def die(msg, code=EXIT_DATA):
    print(json.dumps({"ok": False, "error": msg}, ensure_ascii=False))
    sys.exit(code)


def usage(msg):
    die("usage: " + msg, EXIT_USAGE)


# ---------------------------------------------------------------- transport
def _proxy_from_env():
    for key in ("https_proxy", "HTTPS_PROXY", "http_proxy", "HTTP_PROXY"):
        val = os.environ.get(key)
        if val:
            return val
    return None


class _ConnectTunnel:
    """Minimal HTTPS-via-CONNECT client (proxy auth pre-sent; urllib through
    this egress proxy intermittently drops, raw http.client is reliable)."""

    def __init__(self, proxy_url):
        p = urllib.parse.urlparse(proxy_url)
        self.host, self.port = p.hostname, p.port or 80
        self.auth = None
        if p.username:
            cred = f"{urllib.parse.unquote(p.username)}:{urllib.parse.unquote(p.password or '')}"
            self.auth = "Basic " + base64.b64encode(cred.encode()).decode()

    def request(self, method, url, headers=None, timeout=30):
        import socket
        u = urllib.parse.urlparse(url)
        target_host = u.hostname
        target_port = u.port or 443
        sock = socket.create_connection((self.host, self.port),
                                        timeout=timeout)
        lines = [f"CONNECT {target_host}:{target_port} HTTP/1.1",
                 f"Host: {target_host}:{target_port}",
                 "Proxy-Connection: keep-alive"]
        if self.auth:
            lines.append(f"Proxy-Authorization: {self.auth}")
        sock.sendall(("\r\n".join(lines) + "\r\n\r\n").encode("latin-1"))
        buf = b""
        while b"\r\n\r\n" not in buf:
            chunk = sock.recv(4096)
            if not chunk:
                sock.close()
                raise ConnectionError("proxy closed during CONNECT")
            buf += chunk
        status_line = buf.split(b"\r\n", 1)[0].decode("latin-1")
        if " 200 " not in status_line and not status_line.endswith(" 200"):
            sock.close()
            raise ConnectionError(f"CONNECT failed: {status_line}")
        ctx = ssl.create_default_context()
        wrapped = ctx.wrap_socket(sock, server_hostname=target_host)
        conn = http.client.HTTPSConnection(target_host, target_port,
                                           timeout=timeout, context=ctx)
        conn.sock = wrapped
        path = u.path + ("?" + u.query if u.query else "")
        conn.putrequest(method, path, skip_host=True,
                        skip_accept_encoding=True)
        conn.putheader("Host", target_host)
        for k, v in (headers or {}).items():
            conn.putheader(k, v)
        conn.endheaders()
        resp = conn.getresponse()
        body = resp.read()
        status = resp.status
        conn.close()
        return status, body


_PROXY = None
_PROXY_CHECKED = False


def fetch_bytes(url, timeout=30):
    """GET url -> (status, bytes). Retries transient failures."""
    global _PROXY, _PROXY_CHECKED
    if not _PROXY_CHECKED:
        p = _proxy_from_env()
        _PROXY = _ConnectTunnel(p) if p else None
        _PROXY_CHECKED = True
    headers = {"User-Agent": UA, "Referer": REFERER,
               "Accept": "application/json, text/plain, */*"}
    last_err = None
    for attempt in range(3):
        try:
            if _PROXY is not None:
                return _PROXY.request("GET", url, headers=headers,
                                      timeout=timeout)
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return r.status, r.read()
        except Exception as exc:  # noqa: BLE001 - report after retries
            last_err = exc
            time.sleep(0.6 * (attempt + 1))
    raise RuntimeError(f"fetch failed after 3 attempts: {url} ({last_err})")


def fetch_json(url, timeout=30):
    last_status = None
    for attempt in range(4):
        status, body = fetch_bytes(url, timeout=timeout)
        if status == 200:
            return json.loads(body.decode("utf-8"))
        last_status = status
        if status in (301, 302, 303, 307, 308):
            # Eastmoney push2 redirects to push2delay; swap host and retry.
            alt = url.replace("push2.eastmoney.com",
                              "push2delay.eastmoney.com")
            if alt != url:
                url = alt
                continue
        if status >= 500:
            time.sleep(0.8 * (attempt + 1))
            continue
        break
    raise RuntimeError(f"HTTP {last_status}: {url}")


# ------------------------------------------------------------- name resolve
def load_stock_list(refresh=False):
    if not refresh and os.path.exists(STOCK_CACHE):
        try:
            if time.time() - os.path.getmtime(STOCK_CACHE) < STOCK_CACHE_TTL:
                with open(STOCK_CACHE, encoding="utf-8") as f:
                    return json.load(f)
        except (OSError, ValueError):
            pass
    stocks, page = [], 1
    while True:
        data = fetch_json(CLIST_URL.format(pn=page))
        block = (data or {}).get("data") or {}
        diff = block.get("diff") or []
        if not diff:
            break
        for item in diff:
            code, name = item.get("f12"), item.get("f14")
            if code and name:
                stocks.append({"code": code, "name": name})
        if len(stocks) >= (block.get("total") or 0):
            break
        page += 1
    if not stocks:
        raise RuntimeError("stock list fetch returned nothing")
    os.makedirs(CACHE_DIR, exist_ok=True)
    with open(STOCK_CACHE, "w", encoding="utf-8") as f:
        json.dump(stocks, f, ensure_ascii=False)
    return stocks


def market_prefix(code):
    """Eastmoney F10 code form: SH for 6/9-leading, SZ otherwise, BJ for
    Beijing exchange (4/8/920-leading)."""
    if code.startswith("920") or code[0] in "48":
        return "BJ"
    if code[0] in "69":
        return "SH"
    return "SZ"


def resolve_company(query, stocks):
    """Return ('unique', stock) | ('ambiguous', [stocks]) | ('none', []).
    A 6-digit query is treated as a code first."""
    q = (query or "").strip()
    if not q:
        return "none", []
    if q.isdigit() and len(q) == 6:
        for s in stocks:
            if s["code"] == q:
                return "unique", s
        return "none", []
    exact = [s for s in stocks if s["name"] == q]
    if len(exact) == 1:
        return "unique", exact[0]
    if len(exact) > 1:
        return "ambiguous", exact
    contains = [s for s in stocks if q in s["name"]]
    if not contains:
        return "none", []
    if len(contains) == 1:
        return "unique", contains[0]
    # Multiple substring hits are genuinely ambiguous (e.g. 平安 matches
    # both 中国平安 and 平安银行); never guess between listed companies.
    contains.sort(key=lambda s: (len(s["name"]), s["code"]))
    return "ambiguous", contains[:10]


# ------------------------------------------------------------------- fetch
def fetch_main_indicators(code_prefixed):
    data = fetch_json(f"{API_BASE}/ZYZBAjaxNew?type=0&code={code_prefixed}")
    rows = data.get("data") or []
    out = {}
    for row in rows:
        date = str(row.get("REPORT_DATE") or "")[:10]
        if date:
            out[date] = row
    return out


STATEMENT_ENDPOINTS = {
    "income": "lrbAjaxNew",
    "balance": "zcfzbAjaxNew",
    "cashflow": "xjllbAjaxNew",
}


def fetch_statement(code_prefixed, kind, dates):
    endpoint = STATEMENT_ENDPOINTS[kind]
    url = (f"{API_BASE}/{endpoint}?companyType=4&reportDateType=0&reportType=1"
           f"&dates={','.join(dates)}&code={code_prefixed}")
    data = fetch_json(url)
    out = {}
    for row in data.get("data") or []:
        date = str(row.get("REPORT_DATE") or "")[:10]
        if date:
            out[date] = row
    return out, url


# ----------------------------------------------------------------- periods
PERIOD_KIND = {"03-31": "Q1", "06-30": "H1", "09-30": "Q3", "12-31": "FY"}
MONTH_DAYS = {"03-31": 90, "06-30": 181, "09-30": 273, "12-31": 365}


def period_label(date_str):
    year, md = date_str[:4], date_str[5:]
    kind = PERIOD_KIND.get(md, md)
    names = {"Q1": f"{year}年一季报（1-3月累计）",
             "H1": f"{year}年半年报（1-6月累计）",
             "Q3": f"{year}年三季报（1-9月累计）",
             "FY": f"{year}年年报（全年）"}
    return names.get(kind, date_str)


def prior_year(date_str):
    return f"{int(date_str[:4]) - 1}{date_str[4:]}"


def prev_cumulative(date_str):
    """Previous cumulative period end within the same year (for single
    quarter derivation); None for Q1."""
    year, md = date_str[:4], date_str[5:]
    chain = {"06-30": "03-31", "09-30": "06-30", "12-31": "09-30"}
    prev = chain.get(md)
    return f"{year}-{prev}" if prev else None


def days_in_period(date_str):
    md = date_str[5:]
    return MONTH_DAYS.get(md)


# ------------------------------------------------------------- derivations
def num(v):
    try:
        return float(v)
    except (TypeError, ValueError):
        return None


def yoy(cur, prev):
    if cur is None or prev is None or prev == 0:
        return None
    return (cur - prev) / abs(prev) * 100.0


def sub(a, b):
    return a - b if a is not None and b is not None else None


def derive_key_indicators(main_row):
    """Key indicators for one period from a ZYZB row (raw yuan / %)."""
    if not main_row:
        return {}
    rev = num(main_row.get("TOTALOPERATEREVE"))
    gp = num(main_row.get("MLR"))
    return {
        "revenue": rev,
        "gross_profit": gp,
        "gross_margin": num(main_row.get("XSMLL")),
        "parent_net_profit": num(main_row.get("PARENTNETPROFIT")),
        "deduct_net_profit": num(main_row.get("KCFJCXSYJLR")),
        "net_margin": num(main_row.get("XSJLL")),
        "eps_basic": num(main_row.get("EPSJB")),
        "roe_weighted": num(main_row.get("ROEJQ")),
        "roic": num(main_row.get("ROIC")),
        "debt_ratio": num(main_row.get("ZCFZL")),
        "operating_cycle": num(main_row.get("OPERATE_CYCLE")),
        "inventory_days": num(main_row.get("CHZZTS")),
        "receivable_days": num(main_row.get("YSZKZZTS")),
        "payable_days": num(main_row.get("PAYABLE_TDAYS")),
    }


# Fields carried into the single-quarter split (flow items only).
SQ_FIELDS = [
    ("revenue", "营业收入"),
    ("gross_profit", "毛利润"),
    ("gross_margin", "毛利率(%)"),
    ("parent_net_profit", "归母净利润"),
    ("deduct_net_profit", "扣非净利润"),
    ("operating_cash_flow", "经营活动现金流净额"),
]


def single_quarter(main_by_date, cash_by_date, target):
    """Derive the single quarter ending at `target` from cumulative data.
    Returns dict or None when the previous cumulative period is missing."""
    prev = prev_cumulative(target)
    if prev is None:
        # Q1: the cumulative figure IS the single quarter.
        cur = derive_key_indicators(main_by_date.get(target))
        if not cur:
            return None
        cur["operating_cash_flow"] = num(
            (cash_by_date.get(target) or {}).get("NETCASH_OPERATE"))
        return {"period": target, "basis": "Q1累计即单季", **cur}
    if target not in main_by_date or prev not in main_by_date:
        return None
    cur = derive_key_indicators(main_by_date[target])
    prv = derive_key_indicators(main_by_date[prev])
    out = {"period": target, "basis": f"累计差分（{target} − {prev}）"}
    for key, _label in SQ_FIELDS:
        if key == "gross_margin":
            continue
        if key == "operating_cash_flow":
            out[key] = sub(num((cash_by_date.get(target) or {}).get("NETCASH_OPERATE")),
                           num((cash_by_date.get(prev) or {}).get("NETCASH_OPERATE")))
        else:
            out[key] = sub(cur.get(key), prv.get(key))
    rev, gp = out.get("revenue"), out.get("gross_profit")
    out["gross_margin"] = (gp / rev * 100.0) if rev and gp is not None else None
    return out


