    "CONSTRUCT_LONG_ASSET": "购建固定资产、无形资产和其他长期资产支付的现金",
    "INVEST_PAY_CASH": "投资支付的现金",
    "TOTAL_INVEST_OUTFLOW": "投资活动现金流出小计",
    "NETCASH_INVEST": "投资活动产生的现金流量净额",
    "RECEIVE_INVEST": "吸收投资收到的现金",
    "RECEIVE_LOAN_CASH": "取得借款收到的现金",
    "TOTAL_FINANCE_INFLOW": "筹资活动现金流入小计",
    "PAY_DEBT_CASH": "偿还债务支付的现金",
    "ASSIGN_DIVIDEND_PORFIT": "分配股利、利润或偿付利息支付的现金",
    "PAY_OTHER_FINANCE": "支付其他与筹资活动有关的现金",
    "TOTAL_FINANCE_OUTFLOW": "筹资活动现金流出小计",
    "NETCASH_FINANCE": "筹资活动产生的现金流量净额",
    "RATE_CHANGE_EFFECT": "汇率变动对现金及现金等价物的影响",
    "CCE_ADD": "现金及现金等价物净增加额",
    "BEGIN_CCE": "加：期初现金及现金等价物余额",
    "END_CCE": "期末现金及现金等价物余额",
    "NETPROFIT": "净利润（附注）",
    "FA_IR_DEPR": "固定资产折旧、油气资产折耗、生产性生物资产折旧",
    "IA_AMORTIZE": "无形资产摊销",
}
STATEMENT_LABELS = {"income": INCOME_LABELS, "balance": BALANCE_LABELS,
                    "cashflow": CASHFLOW_LABELS}
META_FIELDS = {
    "SECUCODE", "SECURITY_CODE", "SECURITY_NAME_ABBR", "SECURITY_TYPE_CODE",
    "ORG_CODE", "REPORT_DATE", "REPORT_TYPE", "REPORT_DATE_TYPE",
    "COMPANY_TYPE", "CURRENCY", "NOTICE_DATE", "UPDATE_DATE",
    "REPORT_DATE_NAME", "SECURITY_TYPE", "TRADE_MARKET_CODE",
    "FINANCE_REPORT_TYPE", "DATE_TYPE_CODE", "IS_CNY",
}
SUFFIX_KINDS = ("_YOY", "_QOQ", "_YOYRATIO", "_RATIO", "_SY", "_TB")


def statement_rows(rows_by_date, kind, dates):
    """Ordered, presentation-ready rows for one statement:
    [(field, label, {date: value})] - curated fields in canonical order
    first, then any other non-empty fields in first-appearance order.
    Per-share fields (EPS) keep yuan values; everything else is yuan."""
    labels = STATEMENT_LABELS[kind]
    present = {}
    order_extra = []
    for date in dates:
        row = rows_by_date.get(date) or {}
        for key in row.keys():
            if key in META_FIELDS or any(key.endswith(s) for s in SUFFIX_KINDS):
                continue
            if key not in present:
                present[key] = True
                if key not in labels:
                    order_extra.append(key)
    ordered = [k for k in labels if k in present] + order_extra

    def has_value(key):
        return any(num((rows_by_date.get(d) or {}).get(key)) is not None
                   for d in dates)

    out = []
    for key in ordered:
        if not has_value(key):
            continue
        vals = {d: num((rows_by_date.get(d) or {}).get(key)) for d in dates}
        out.append((key, labels.get(key, key), vals))
    return out


# --------------------------------------------------------------- workbook
def build_workbook(path, ctx):
    """ctx: dict with company, target, compare, main, statements, sq, urls."""
    from openpyxl import Workbook
    from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
    from openpyxl.utils import get_column_letter

    navy = "013C87"
    light_blue = PatternFill("solid", fgColor="D9E2F3")
    header_fill = PatternFill("solid", fgColor=navy)
    header_font = Font(name="微软雅黑", size=11, bold=True, color="FFFFFF")
    title_font = Font(name="微软雅黑", size=14, bold=True, color="C00000")
    body_font = Font(name="微软雅黑", size=10)
    small_font = Font(name="微软雅黑", size=9, color="666666")
    thin = Side(style="thin", color="BFBFBF")
    border = Border(left=thin, right=thin, top=thin, bottom=thin)
    center = Alignment(horizontal="center", vertical="center", wrap_text=True)
    left = Alignment(horizontal="left", vertical="center", wrap_text=True)
    money_fmt = '#,##0'
    pct_fmt = '0.0'

    company = ctx["company"]
    target, compare = ctx["target"], ctx["compare"]
    tlabel, clabel = period_label(target), period_label(compare)
    wb = Workbook()

    # ---- 说明
    ws = wb.active
    ws.title = "说明"
    ws.sheet_properties.pageSetUpPr.fitToPage = True
    ws["A1"] = f"{company['name']}（{company['code']}）财务报告数据"
    ws["A1"].font = title_font
    info = [
        ("公司", f"{company['name']}（{company['code']}，{company['market']}）"),
        ("本期", f"{target} · {tlabel}"),
        ("对比期", f"{compare} · {clabel}"),
        ("口径", "正式财报（季报/半年报/年报）；不含业绩预告、快报与预测数。金额单位：千元（K元），比率为 %，周转天数为天，每股收益为元/股。"),
        ("累计与单季", "三大报表与主要指标为报告期累计口径；「单季拆分」页为累计差分（Q1 为累计值本身），仅含流量指标，资产负债表等时点指标不拆分。"),
        ("周转天数", "取东方财富主要指标接口原值（CHZZTS/YSZKZZTS/PAYABLE_TDAYS），不做本地重算（经与公告勾稽，接口口径与公司披露口径一致，本地重算会引入偏差）。"),
        ("数据源", "东方财富 F10 结构化接口（主要指标 ZYZBAjaxNew、利润表 lrbAjaxNew、资产负债表 zcfzbAjaxNew、现金流量表 xjllbAjaxNew），与半导体友商监控同源。"),
        ("生成", f"finreport v{VERSION} · {ctx['generated_at']}"),
    ]
    r = 3
    for k, v in info:
        ws.cell(r, 1, k).font = Font(name="微软雅黑", size=10, bold=True)
        c = ws.cell(r, 2, v)
        c.font = body_font
        c.alignment = Alignment(wrap_text=True, vertical="center")
        ws.row_dimensions[r].height = 30 if len(v) > 60 else 16
        r += 1
    ws.column_dimensions["A"].width = 12
    ws.column_dimensions["B"].width = 110
    r += 1
    ws.cell(r, 1, "接口链接（审计留痕）").font = Font(name="微软雅黑", size=10, bold=True)
    for name, url in ctx["source_urls"].items():
        r += 1
        ws.cell(r, 1, name).font = small_font
        c = ws.cell(r, 2, url)
        c.font = small_font
        c.hyperlink = url

    # ---- 关键指标
    ws = wb.create_sheet("关键指标")
    ws.sheet_properties.pageSetUpPr.fitToPage = True
    ws.page_setup.orientation = "landscape"
    ws.page_setup.fitToWidth = 1
    ws.merge_cells("A1:F1")
    ws["A1"] = f"{company['name']} 关键指标（{tlabel} vs {clabel}）"
    ws["A1"].font = title_font
    headers = ["指标", f"本期 {target}", f"同期 {compare}", "同比/增减", "单位", "备注"]
    for i, h in enumerate(headers, 1):
        c = ws.cell(2, i, h)
        c.font = header_font
        c.fill = header_fill
        c.alignment = center
        c.border = border
    cur_i = derive_key_indicators(ctx["main"].get(target))
    prv_i = derive_key_indicators(ctx["main"].get(compare))
    inc_t = ctx["statements"]["income"].get(target) or {}
    inc_p = ctx["statements"]["income"].get(compare) or {}
    bal_t = ctx["statements"]["balance"].get(target) or {}
    cf_t = ctx["statements"]["cashflow"].get(target) or {}
    cf_p = ctx["statements"]["cashflow"].get(compare) or {}

    def k(v):
        return v / 1000.0 if v is not None else None

    rows = [
        ("营业收入", k(cur_i.get("revenue")), k(prv_i.get("revenue")), "money", "千元", ""),
        ("营业成本", k(num(inc_t.get("OPERATE_COST"))), k(num(inc_p.get("OPERATE_COST"))), "money", "千元", "利润表"),
        ("毛利润", k(cur_i.get("gross_profit")), k(prv_i.get("gross_profit")), "money", "千元", "收入−营业成本（接口原值 MLR）"),
        ("毛利率", cur_i.get("gross_margin"), prv_i.get("gross_margin"), "pp", "%", ""),
        ("营业利润", k(num(inc_t.get("OPERATE_PROFIT"))), k(num(inc_p.get("OPERATE_PROFIT"))), "money", "千元", "利润表"),
        ("归母净利润", k(cur_i.get("parent_net_profit")), k(prv_i.get("parent_net_profit")), "money", "千元", ""),
        ("扣非净利润", k(cur_i.get("deduct_net_profit")), k(prv_i.get("deduct_net_profit")), "money", "千元", ""),
        ("净利率", cur_i.get("net_margin"), prv_i.get("net_margin"), "pp", "%", ""),
        ("研发费用", k(num(inc_t.get("RESEARCH_EXPENSE"))), k(num(inc_p.get("RESEARCH_EXPENSE"))), "money", "千元", "利润表"),
        ("销售费用", k(num(inc_t.get("SALE_EXPENSE"))), k(num(inc_p.get("SALE_EXPENSE"))), "money", "千元", "利润表"),
        ("管理费用", k(num(inc_t.get("MANAGE_EXPENSE"))), k(num(inc_p.get("MANAGE_EXPENSE"))), "money", "千元", "利润表"),
        ("财务费用", k(num(inc_t.get("FINANCE_EXPENSE"))), k(num(inc_p.get("FINANCE_EXPENSE"))), "money", "千元", "利润表"),
        ("经营活动现金流净额", k(num(cf_t.get("NETCASH_OPERATE"))), k(num(cf_p.get("NETCASH_OPERATE"))), "money", "千元", "现金流量表"),
        ("资本开支（购建长期资产）", k(num(cf_t.get("CONSTRUCT_LONG_ASSET"))), k(num(cf_p.get("CONSTRUCT_LONG_ASSET"))), "money", "千元", "现金流量表"),
        ("基本每股收益", cur_i.get("eps_basic"), prv_i.get("eps_basic"), "raw", "元/股", ""),
        ("加权 ROE", cur_i.get("roe_weighted"), prv_i.get("roe_weighted"), "pp", "%", ""),
        ("ROIC", cur_i.get("roic"), prv_i.get("roic"), "pp", "%", ""),
        ("资产负债率", cur_i.get("debt_ratio"), prv_i.get("debt_ratio"), "pp", "%", ""),
        ("期末存货", k(num(bal_t.get("INVENTORY"))), None, "point", "千元", "资产负债表（本期期末）"),
        ("期末应收账款", k(num(bal_t.get("ACCOUNTS_RECE"))), None, "point", "千元", "资产负债表（本期期末）"),
        ("期末应付账款", k(num(bal_t.get("ACCOUNTS_PAYABLE"))), None, "point", "千元", "资产负债表（本期期末）"),
        ("存货周转天数", cur_i.get("inventory_days"), prv_i.get("inventory_days"), "days", "天", "接口原值"),
        ("应收账款周转天数", cur_i.get("receivable_days"), prv_i.get("receivable_days"), "days", "天", "接口原值"),
        ("应付账款周转天数", cur_i.get("payable_days"), prv_i.get("payable_days"), "days", "天", "接口原值"),
        ("营运周期", cur_i.get("operating_cycle"), prv_i.get("operating_cycle"), "days", "天", "接口原值"),
    ]
    r = 3
    for label, cur, prv, kind, unit, note in rows:
        ws.cell(r, 1, label).font = body_font
        ws.cell(r, 1).alignment = left
        for col, val in ((2, cur), (3, prv)):
            c = ws.cell(r, col)
            c.font = body_font
            c.border = border
            c.alignment = center
            if val is not None:
                c.value = round(val, 2) if kind in ("pp", "days", "raw") else round(val, 2)
                c.number_format = money_fmt if kind == "money" else '0.00'
        delta_cell = ws.cell(r, 4)
        delta_cell.font = body_font
        delta_cell.border = border
        delta_cell.alignment = center
        if kind == "money":
            g = yoy(cur, prv)
            if g is not None:
                delta_cell.value = round(g / 100.0, 4)
                delta_cell.number_format = '0.0%'
        elif kind == "pp":
            if cur is not None and prv is not None:
                delta_cell.value = f"{cur - prv:+.1f} 个百分点"
        elif kind == "days":
            if cur is not None and prv is not None:
                delta_cell.value = f"{cur - prv:+.1f} 天"
        elif kind == "raw":
            g = yoy(cur, prv)
            if g is not None:
                delta_cell.value = round(g / 100.0, 4)
                delta_cell.number_format = '0.0%'
        ws.cell(r, 5, unit).font = small_font
        ws.cell(r, 5).alignment = center
        ws.cell(r, 6, note).font = small_font
        ws.cell(r, 6).alignment = left
        for col in (1, 5, 6):
            ws.cell(r, col).border = border
        r += 1
    widths = [26, 18, 18, 16, 8, 34]
    for i, w in enumerate(widths, 1):
        ws.column_dimensions[get_column_letter(i)].width = w

    # ---- 三大报表
    sheet_titles = {"income": "利润表", "balance": "资产负债表",
                    "cashflow": "现金流量表"}
    per_share = {"BASIC_EPS", "DILUTED_EPS"}
    for kind, title in sheet_titles.items():
        ws = wb.create_sheet(title)
        ws.sheet_properties.pageSetUpPr.fitToPage = True
        ws.page_setup.orientation = "portrait"
        ws.page_setup.fitToWidth = 1
        ws.merge_cells("A1:E1")
        ws["A1"] = f"{company['name']} {title}（累计口径，金额：千元；每股收益：元/股）"
        ws["A1"].font = title_font
        headers = ["科目", f"本期 {target}", f"同期 {compare}", "同比", "字段代码"]
        for i, h in enumerate(headers, 1):
            c = ws.cell(2, i, h)
            c.font = header_font
            c.fill = header_fill
            c.alignment = center
            c.border = border
        srows = statement_rows(ctx["statements"][kind], kind, [target, compare])
        r = 3
        for field, label, vals in srows:
            ws.cell(r, 1, label).font = body_font
            ws.cell(r, 1).alignment = left
            scale = 1.0 if field in per_share else 1000.0
            for col, date in ((2, target), (3, compare)):
                c = ws.cell(r, col)
                c.font = body_font
                c.border = border
                c.alignment = center
                v = vals.get(date)
                if v is not None:
                    c.value = round(v / scale, 2)
                    c.number_format = money_fmt if scale != 1.0 else '0.00'
            dcell = ws.cell(r, 4)
            dcell.font = body_font
            dcell.border = border
            dcell.alignment = center
            if kind != "balance":
                g = yoy(vals.get(target), vals.get(compare))
                if g is not None:
                    dcell.value = round(g / 100.0, 4)
                    dcell.number_format = '0.0%'
            else:
                diff = sub(vals.get(target), vals.get(compare))
                if diff is not None:
                    dcell.value = round(diff / scale, 2)
                    dcell.number_format = money_fmt
                    ws.cell(r, 4).value = round(diff / scale, 2)
            ws.cell(r, 5, field).font = small_font
            ws.cell(r, 5).alignment = center
            for col in (1, 5):
                ws.cell(r, col).border = border
            r += 1
        for i, w in enumerate([52, 18, 18, 13, 30], 1):
            ws.column_dimensions[get_column_letter(i)].width = w
        if kind == "balance":
            ws.cell(2, 4, "较同期增减（千元）")

    # ---- 单季拆分
    ws = wb.create_sheet("单季拆分")
    ws.sheet_properties.pageSetUpPr.fitToPage = True
    ws.merge_cells("A1:E1")
    sq = ctx.get("sq")
    sq_prev = ctx.get("sq_prev")
    qname = {"03-31": "Q1", "06-30": "Q2", "09-30": "Q3", "12-31": "Q4"}[target[5:]]
    ws["A1"] = f"{company['name']} 单季拆分（{target[:4]} 年 {qname} 单季 vs 上年同期单季）"
    ws["A1"].font = title_font
    headers = ["指标", f"本期单季 {target}", f"同期单季 {compare}", "同比", "单位"]
    for i, h in enumerate(headers, 1):
        c = ws.cell(2, i, h)
        c.font = header_font
        c.fill = header_fill
        c.alignment = center
        c.border = border
    r = 3
    if sq and sq_prev:
        for key, label in SQ_FIELDS:
            ws.cell(r, 1, label).font = body_font
            ws.cell(r, 1).alignment = left
            cur, prv = sq.get(key), sq_prev.get(key)
            for col, val in ((2, cur), (3, prv)):
                c = ws.cell(r, col)
                c.font = body_font
                c.border = border
                c.alignment = center
                if val is not None:
                    c.value = round(val / 1000.0, 2) if key != "gross_margin" else round(val, 2)
                    c.number_format = money_fmt if key != "gross_margin" else '0.00'
            dcell = ws.cell(r, 4)
            dcell.font = body_font
            dcell.border = border
            dcell.alignment = center
            if key == "gross_margin":
                if cur is not None and prv is not None:
                    dcell.value = f"{cur - prv:+.1f} 个百分点"
            else:
                g = yoy(cur, prv)
                if g is not None:
                    dcell.value = round(g / 100.0, 4)
                    dcell.number_format = '0.0%'
            ws.cell(r, 5, "%" if key == "gross_margin" else "千元").font = small_font
            ws.cell(r, 5).alignment = center
            for col in (1, 5):
                ws.cell(r, col).border = border
            r += 1
        ws.cell(r + 1, 1, f"拆分方法：{sq.get('basis', '累计差分')}；仅流量指标，时点指标不拆分。").font = small_font
    else:
        ws.cell(3, 1, "单季拆分不可用：缺少前一累计期数据（接口未返回）。").font = body_font
    for i, w in enumerate([26, 18, 18, 14, 8], 1):
        ws.column_dimensions[get_column_letter(i)].width = w

    wb.save(path)


# -------------------------------------------------------------------- main
def cmd_report(args):
    stocks = load_stock_list(refresh=args.refresh_list)
    status, found = resolve_company(args.company, stocks)
    if status == "none":
        die(f"未找到公司：{args.company}（不在 A 股列表中，或已退市）")
    if status == "ambiguous":
        print(json.dumps({
            "ok": False, "error": "公司名称有歧义，请用代码或更完整的名称",
            "candidates": [{"code": s["code"], "name": s["name"],
                            "market": market_prefix(s["code"])}
                           for s in found]}, ensure_ascii=False))
        sys.exit(EXIT_DATA)
    stock = found
    code, name = stock["code"], stock["name"]
    market = market_prefix(code)
    prefixed = f"{market}{code}"

    main = fetch_main_indicators(prefixed)
    if not main:
        die(f"{name}（{code}）主要指标接口无数据")
    if args.date:
        target = args.date
        if target not in main:
            die(f"{name} 在 {target} 无正式财报数据（已披露期间："
                f"{sorted(main.keys(), reverse=True)[:6]}）")
    else:
        target = max(main.keys())
    compare = prior_year(target)

    need_dates = {target, compare}
    prev = prev_cumulative(target)
    if prev:
        need_dates.add(prev)
    prev_p = prev_cumulative(compare)
    if prev_p:
        need_dates.add(prev_p)
    need_dates = sorted(need_dates)

    statements, source_urls = {}, {
        "main_indicators": f"{API_BASE}/ZYZBAjaxNew?type=0&code={prefixed}"}
    for kind in STATEMENT_ENDPOINTS:
        statements[kind], url = fetch_statement(prefixed, kind, need_dates)
        source_urls[kind] = url
    if target not in statements["income"]:
        die(f"{name} {target} 利润表无数据（接口未返回该期间）")

    sq = single_quarter(main, statements["cashflow"], target)
    sq_prev = single_quarter(main, statements["cashflow"], compare)

    ctx = {
        "company": {"name": name, "code": code, "market": market},
        "target": target, "compare": compare,
        "main": main, "statements": statements,
        "sq": sq, "sq_prev": sq_prev,
        "source_urls": source_urls,
        "generated_at": datetime.now().strftime("%Y-%m-%d %H:%M"),
    }
    result = {
        "ok": True, "company": ctx["company"],
        "target": target, "target_label": period_label(target),
        "compare": compare, "notice_date": str(
            (statements["income"].get(target) or {}).get("NOTICE_DATE") or "")[:10],
        "key_indicators": {
            "current": derive_key_indicators(main.get(target)),
            "compare": derive_key_indicators(main.get(compare)),
        },
        "single_quarter": {"current": sq, "compare": sq_prev},
        "workbook": None,
    }
    if not args.json_only:
        out = args.output or os.path.join(
            os.getcwd(),
            f"{name}_{target[:4]}{PERIOD_KIND.get(target[5:], '')}财报_{target}.xlsx")
        build_workbook(out, ctx)
        result["workbook"] = out
    print(json.dumps(result, ensure_ascii=False, indent=2))
    return EXIT_OK


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return EXIT_OK
    cmd = argv[0]
    if cmd == "resolve":
        if len(argv) < 2:
            usage("resolve <公司名称或代码>")
        stocks = load_stock_list()
        status, found = resolve_company(argv[1], stocks)
        if status == "unique":
            s = found
            print(json.dumps({"ok": True, "code": s["code"], "name": s["name"],
                              "market": market_prefix(s["code"])},
                             ensure_ascii=False))
        elif status == "ambiguous":
            print(json.dumps({"ok": False, "error": "ambiguous",
                              "candidates": found}, ensure_ascii=False))
            return EXIT_DATA
        else:
            print(json.dumps({"ok": False, "error": "not found"},
                             ensure_ascii=False))
            return EXIT_DATA
        return EXIT_OK
    if cmd == "report":
        import argparse
        parser = argparse.ArgumentParser(prog="finreport report")
        parser.add_argument("company", help="公司名称（简称/全称）或 6 位代码")
        parser.add_argument("--date", help="报告期 YYYY-MM-DD（默认最新披露期）")
        parser.add_argument("--output", help="工作簿输出路径")
        parser.add_argument("--json-only", action="store_true",
                            help="只输出 JSON 摘要，不生成工作簿")
        parser.add_argument("--refresh-list", action="store_true",
                            help="强制刷新本地股票列表缓存")
        args = parser.parse_args(argv[1:])
        return cmd_report(args)
    usage(f"unknown command: {cmd}（可用：report / resolve）")
    return EXIT_USAGE


if __name__ == "__main__":
    sys.exit(main())
